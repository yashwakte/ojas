// Reference only - copy the keys you need into appsettings.Development.json (gitignored, never
// committed) or set them as environment variables in Render, using double underscores in place
// of colons (e.g. Smtp__Host). This file is never loaded by the app itself, which is why it can
// hold comments and placeholder values despite the .jsonc extension not being a real ASP.NET
// Core config source.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority",
    "DatabaseName": "OjasDb"
  },
  "Jwt": {
    "Key": "<your-secret-key-at-least-32-characters>",
    "Issuer": "OjasApi",
    "Audience": "OjasApp"
  },
  // Hostinger SMTP for wecare@ojasaata.com - kept for a host that allows outbound SMTP, but NOT
  // the live sender (see Resend below). Render blocks outbound SMTP entirely (confirmed
  // 2026-08-21, both port 465 and 587 time out), which is why Resend's HTTP API is used instead.
  "Smtp": {
    "Host": "smtp.hostinger.com",
    "Port": 465,
    "UseSsl": true,
    "Username": "wecare@ojasaata.com",
    "Password": "<hostinger-mailbox-password>",
    "SenderEmail": "wecare@ojasaata.com",
    "SenderName": "Ojas"
  },
  // Resend - the live transactional email sender (ResendEmailSender), unaffected by Render's
  // SMTP block because it's an HTTPS API. FromEmail sends from a dedicated subdomain rather than
  // the root domain (Resend's own deliverability guidance), so high-volume OTP mail can never
  // damage the sending reputation of the real mailbox; ReplyTo points back at that real mailbox
  // so a customer who hits reply still reaches a human.
  "Resend": {
    "ApiKey": "<resend-api-key>",
    "FromEmail": "wecare@notifications.ojasaata.com",
    "FromName": "Ojas",
    "ReplyTo": "wecare@ojasaata.com"
  },
  // Where staff invite links point. Must be the real site origin in Production, or the emailed
  // "set up my account" link will send people to localhost.
  "Frontend": {
    "BaseUrl": "https://ojas-atta.vercel.app"
  },
  // Outside Production, OTP emails are logged instead of sent - the code comes back in the API
  // response as devCode and the UI displays it. Set this to true only when you specifically want
  // to test real delivery.
  "Email": {
    "SendInDevelopment": false
  },
  // Msg91WidgetVerifier's server-side secret, from the OTP Widget's Server Side Integration tab
  // (Create Authkey). Scoped to the User role and the OTP widget only, with IP Security off
  // (Render's shared/non-static outbound IPs make IP whitelisting here unreliable rather than
  // safer). This is what verifies the phone number given at registration - the widget's own
  // default channel configuration sends through MSG91's own pre-registered template and does not
  // require this business's own DLT registration, which is why this is live today.
  "Msg91": {
    "WidgetAuthKey": "<otp-widget-server-side-authkey>"
  },
  // Cashfree Payment Gateway - inert (returns 503 on checkout) until ClientId/ClientSecret are
  // set. Sandbox and production use separate, distinct credential pairs from Cashfree's
  // dashboard - Environment picks the base URL, but you must also swap the credentials
  // themselves when going live, not just this value.
  "Cashfree": {
    "Environment": "sandbox",
    "ClientId": "<cashfree-client-id>",
    "ClientSecret": "<cashfree-client-secret>"
  },
  // For local dev, use Cloudflare's dummy pair (works on any domain): secret
  // 1x0000000000000000000000000000000AA, paired with site key 1x00000000000000000000AA in the
  // frontend. Use real keys from your Cloudflare Turnstile dashboard in production.
  "Turnstile": {
    "SecretKey": "<turnstile-secret-key>"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://ojas-atta.vercel.app"
    ],
    "AllowVercelPreviewOrigins": false
  },
  // Error tracking - inert if left unset, no account needed to keep developing. Create a free
  // project at sentry.io and paste its DSN here to switch it on.
  "Sentry": {
    "Dsn": ""
  }
}
